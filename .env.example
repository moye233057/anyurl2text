# 把本文件复制到**项目根目录**（anyurl2text/）并改名为 .env 后填写。
# 注意：后端只读项目根目录的这一份；放在 backend/ 下不会被读取，且不会报错——只会静默使用默认值。
# DeepSeek。模型名用现行名，旧的 deepseek-v4-flash / vision-exp 已下线。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 单次模型调用的超时（秒）
LLM_TIMEOUT_SEC=180
# 模型调用失败的重试次数
LLM_MAX_RETRIES=3

# 思考模式：默认开且 effort=high，思维链按输出侧计费，所以默认关闭；
# 仅「按 query 摘要」会临时打开。
THINKING_ENABLED=false
THINKING_EFFORT=high

# 服务
ANYURL2TEXT_HOST=127.0.0.1
ANYURL2TEXT_PORT=8020
# 前端 dev server 端口（start.py 与 vite.config.ts 同读这一项）
FRONTEND_PORT=5173
# 自动重载：默认 false（与代码里的默认值一致）。设 true 后改 backend/ 下的 .py 立即生效，
# 不用手动重启；代价是多一个监督进程，且改任何 .py 都会重启——正跑 HTTP 接口用例时会成批读超时。
# 它只监视 .py，改 .env 仍要重启；见 RUNBOOK 第 6 节「改了后端代码没生效」。
RELOAD=false

# 请求生命周期：全链路预算（秒）与下载单独上限（秒）
REQUEST_BUDGET_SEC=120
DOWNLOAD_BUDGET_SEC=20
CONCURRENCY_FAST=32
CONCURRENCY_MEDIA=8
# DeepSeek 出口同时在途上限（默认很宽；本机自用一般不用改）
EGRESS_LLM_CONCURRENCY=64
# 第三方 DeepSeek 单请求成本控制（默认关；本机 OCR/ASR 不受影响）
DEEPSEEK_COST_LIMIT_ENABLED=false
DEEPSEEK_MAX_COST_CNY=1.0
DEEPSEEK_TOKEN_LIMIT_ENABLED=false
DEEPSEEK_MAX_TOKENS_PER_REQUEST=200000

# 下载层
MAX_DOWNLOAD_BYTES=209715200
# 建连超时（秒）：只算握手，不含等响应
CONNECT_TIMEOUT_SEC=10
# 读超时（秒）：等响应体的上限
READ_TIMEOUT_SEC=30
# 最多跟随几次重定向，超了按下载失败处理
MAX_REDIRECTS=5
# 请求头里的 User-Agent，有些站点只认浏览器 UA
ANYURL2TEXT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36
# 仅供本机串本地文件服务调试，任何对外可访问的部署都必须保持 false
ALLOW_PRIVATE_HOSTS=false
# 是否接受 http:// 源：默认 true = http 与 https 都收（与既有行为一致）；
# 置 false 后只收 https，http:// 在发起连接之前就被 422 拒掉。
ALLOW_HTTP_SOURCE=true

# 扫描件 PDF 逐页渲染
RENDERED_PAGE_OCR_ENABLED=true
RENDERED_PAGE_MAX=10

# 第三方服务（services/{ocr,asr}/<实现>/；权重在各实现自己的 models/）
# start.py 在 START_SERVICES=true 且默认实现权重就绪时尝试一并拉起；也可按 services/ 下 README 手动起。
START_SERVICES=true
OCR_PORT=8021
ASR_PORT=8022
OCR_API_URL=http://127.0.0.1:8021/ocr-b64
OCR_TIMEOUT_SEC=60
ASR_API_URL=http://127.0.0.1:8022/asr-b64
ASR_TIMEOUT_SEC=300
# 送转写的音轨时长上限（秒），超过就跳过并在 meta.notes 里说明；
# 设它是因为服务单次输出有 token 上限，长音轨的尾部会被静默丢掉。
ASR_MAX_AUDIO_SECONDS=600
# 抽音轨超时（秒）：转码是本地 CPU 活，与模型超时分开计
FFMPEG_TIMEOUT_SEC=120

# ---- 以下一般不用改；想控成本或调清晰度时再动 ----
# content 的字符上限；超出会在 meta.truncated 里声明
MAX_CONTENT_CHARS=200000
# 送进模型的文本上限（比 content 上限更低，直接决定摘要那一次调用的输入 token）
MAX_MODEL_INPUT_CHARS=120000
# 每份文档最多 OCR 几张内嵌图（看图开关 ocr∧llm 时才会用到）
MAX_EMBEDDED_IMAGES=3
# 单次模型调用的输出上限；官方默认非思考模式只有 8K，不显式给会被静默截断
LLM_MAX_TOKENS=8192
# 页面渲染 DPI：模型侧会把图缩到约 1300x1300 总像素，再高没有收益
RENDERED_PAGE_DPI=150
# 整页识别结果短于该字符数就判定「没认出来」，切成上下两半重试
RENDERED_PAGE_RETRY_MIN_CHARS=20

# 调试：把中间产物落到 data/debug/
DEBUG_ARTIFACTS=false
