# 密钥与本地配置：绝不入库
.env
.env.*
# 例外：配置模板必须入库。`.env.*` 会连 `.env.example` 一起忽略，
# 而 README 让使用者复制它——不放行的话 clone 下来没有可复制的样本。
!.env.example

# 第三方服务权重与运行时产物（保留各服务 models/README.md）
services/**/models/**
!services/**/models/README.md
services/**/logs/
services/**/temp/

# 运行产物（都在 backend/data/ 下）
backend/data/debug/
backend/data/logs/
*.log

# 大件样例：18.67 MB，由 make_fixtures.py 阶段 6 生成，不入库。
# backend/data/ 下其余样例照常入库——其中 7 个（plain.txt / table.csv / sample.json /
# feed.xml / page.html / sample.rtf / notes.md）不是脚本生成的，只有仓库里有。
backend/data/scanned.pdf

# Python 环境与缓存（任意深度；核心 uv 与 services 各自 venv 都不入库）
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
.uv/

# 前端
frontend/node_modules/
frontend/dist/
frontend/.vite/

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~
